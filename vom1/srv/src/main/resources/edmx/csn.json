{
  "namespace": "oms",
  "definitions": {
    "oms.ApiLog": {
      "kind": "entity",
      "elements": {
        "ID": {
          "key": true,
          "type": "cds.UUID"
        },
        "userId": {
          "type": "cds.String",
          "length": 100
        },
        "userName": {
          "type": "cds.String",
          "length": 100
        },
        "event": {
          "type": "cds.String",
          "length": 20
        },
        "entityName": {
          "type": "cds.String",
          "length": 100
        },
        "timestamp": {
          "type": "cds.Timestamp"
        }
      }
    },
    "vehicle.state": {
      "kind": "entity",
      "elements": {
        "stateId": {
          "key": true,
          "type": "cds.String",
          "length": 2
        },
        "stateName": {
          "type": "cds.String",
          "length": 20
        }
      }
    },
    "vehicle.VehicleModel": {
      "kind": "entity",
      "elements": {
        "modelId": {
          "key": true,
          "type": "cds.String",
          "length": 20
        },
        "modelName": {
          "type": "cds.String",
          "length": 25
        },
        "manufacturer": {
          "type": "cds.String",
          "length": 25
        },
        "fuelType": {
          "type": "cds.String",
          "length": 15
        },
        "vehicles": {
          "type": "cds.Association",
          "cardinality": {
            "max": "*"
          },
          "target": "vehicle.Vehicle",
          "on": [
            {
              "ref": [
                "vehicles",
                "model"
              ]
            },
            "=",
            {
              "ref": [
                "$self"
              ]
            }
          ]
        }
      }
    },
    "vehicle.Vehicle": {
      "kind": "entity",
      "elements": {
        "vehicleId": {
          "key": true,
          "type": "cds.String",
          "length": 20
        },
        "vehicleName": {
          "type": "cds.String",
          "length": 30
        },
        "oldPrice": {
          "type": "cds.Decimal",
          "precision": 15,
          "scale": 2
        },
        "newPrice": {
          "type": "cds.Decimal",
          "precision": 15,
          "scale": 2
        },
        "status": {
          "type": "cds.String",
          "length": 20
        },
        "state": {
          "type": "cds.Association",
          "target": "vehicle.state",
          "keys": [
            {
              "ref": [
                "stateId"
              ],
              "$generatedFieldName": "state_stateId"
            }
          ]
        },
        "state_stateId": {
          "type": "cds.String",
          "length": 2,
          "@odata.foreignKey4": "state"
        },
        "model": {
          "type": "cds.Association",
          "target": "vehicle.VehicleModel",
          "keys": [
            {
              "ref": [
                "modelId"
              ],
              "$generatedFieldName": "model_modelId"
            }
          ]
        },
        "model_modelId": {
          "type": "cds.String",
          "length": 20,
          "@odata.foreignKey4": "model"
        }
      }
    },
    "vehicle.Customer": {
      "kind": "entity",
      "includes": [
